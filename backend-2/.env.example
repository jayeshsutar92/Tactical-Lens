# Application Environment (development, testing, production)
NODE_ENV=development
APP_ENV=development

# Server Port
PORT=8000

# Application Metadata
PROJECT_NAME="PressLens API (Node.js)"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL connection string)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presslens

# CORS Configuration (comma-separated list of allowed frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Centralized Logging Level (debug, info, warn, error)
LOG_LEVEL=info

# Groq LLM Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=30000
GROQ_MAX_RETRIES=3

# Embeddings & RAG Configuration
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
